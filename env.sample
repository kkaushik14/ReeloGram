REELOGRAM_MONGODB_URL=mongodb://127.0.0.1:27017/reelogram
# Generate with: openssl rand -base64 32
REELOGRAM_NEXTAUTH_SECRET=
REELOGRAM_NEXTAUTH_URL=http://localhost:3000
# Shared app origin for authentication, email and SEO. In production set this to your HTTPS domain.
# Local dev overrides both URLs to localhost:3000 for its process.
REELOGRAM_APP_URL=http://localhost:3000
REELOGRAM_NEXT_PUBLIC_PUBLIC_KEY="<YOUR_IMAGEKIT_PUBLIC_KEY>"
REELOGRAM_NEXT_PUBLIC_URL_ENDPOINT="<YOUR_IMAGEKIT_URL_ENDPOINT>"
REELOGRAM_PRIVATE_KEY="<YOUR_IMAGEKIT_PRIVATE_KEY>"

# SMTP email (use your provider's application password if required)
REELOGRAM_EMAIL_PROVIDER=smtp
REELOGRAM_SMTP_HOST=smtp.example.com
REELOGRAM_SMTP_PORT=587
REELOGRAM_SMTP_USER=
REELOGRAM_SMTP_PASSWORD=
REELOGRAM_EMAIL_FROM="ReeloGram <your-mailbox@example.com>"
# To enable Brevo first with the above SMTP service as quota fallback:
# REELOGRAM_EMAIL_PROVIDER=brevo
# REELOGRAM_BREVO_API_KEY=
# Optional Brevo-only verified sender (SMTP keeps REELOGRAM_EMAIL_FROM):
# REELOGRAM_BREVO_EMAIL_FROM="ReeloGram <hello@your-domain.com>"
# Conservative rolling 24-hour maximum, 0..300. 0 routes new messages to SMTP.
# REELOGRAM_BREVO_DAILY_LIMIT=300
# Optional overrides:
# REELOGRAM_SMTP_SECURE=1
# REELOGRAM_EMAIL_REPLY_TO=support@example.com
# REELOGRAM_AUTH_TRUST_PROXY=1
# For the optional Resend adapter:
# REELOGRAM_RESEND_API_KEY=

# Optional Upstash shared protection/cache; configure both values together.
# Vercel's Upstash integration can provide these with the REELOGRAM prefix.
# Use the write REST token, never the read-only token. See docs/redis.md.
# REELOGRAM_KV_REST_API_URL=https://your-database.upstash.io
# REELOGRAM_KV_REST_API_TOKEN=
# Optional explicit namespace for isolated maintenance/test processes:
# REELOGRAM_REDIS_NAMESPACE=

# Read-only Super Admin integration. Disabled until explicitly provisioned.
REELOGRAM_ADMIN_ENABLED=0
REELOGRAM_ADMIN_PROJECT_ID=reelogram
# Exact identity; never inferred from request headers. local/staging/production.
REELOGRAM_ADMIN_ENVIRONMENT=
# Exact origin without trailing slash. HTTPS except explicit local loopback.
REELOGRAM_ADMIN_AUDIENCE=
# Non-secret credential ID, matching SUPERADMIN_PROJECT_REELOGRAM_KEY_ID.
REELOGRAM_ADMIN_KEY_ID=
# Independent random secret (32+ characters), matching the control app's
# SUPERADMIN_PROJECT_REELOGRAM_SECRET. Never reuse NEXTAUTH or provider secrets.
REELOGRAM_ADMIN_SECRET=

# Optional previous key during rotation only (maximum 24-hour overlap).
# Use an absolute UTC deadline such as YYYY-MM-DDTHH:MM:SSZ; remove to revoke.
REELOGRAM_ADMIN_PREVIOUS_KEY_ID=
REELOGRAM_ADMIN_PREVIOUS_SECRET=
REELOGRAM_ADMIN_PREVIOUS_VALID_UNTIL=
